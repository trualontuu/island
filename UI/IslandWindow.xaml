<Window x:Class="Island.UI.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Island.UI"
        Title="Island" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Width="200" Height="50" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="White" AllowDrop="True">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="Card" Color="#1C1C1F"/>
        <SolidColorBrush x:Key="CardHover" Color="#2A2A2E"/>
        <SolidColorBrush x:Key="Dim" Color="#8E8E93"/>
        <SolidColorBrush x:Key="Line" Color="#26FFFFFF"/>

        <!-- Плитка быстрого действия -->
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Круглая иконка-кнопка -->
        <Style x:Key="Icon" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#22FFFFFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вкладка -->
        <Style x:Key="TabBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="GroupName" Value="tabs"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="12" Padding="10,5" Margin="0,0,4,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2C2C30"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строка списка (Wi-Fi, BT, буфер) -->
        <Style x:Key="Row" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Переключатель -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="track" Width="36" Height="20" CornerRadius="10" Background="#3A3A3E">
                            <Ellipse x:Name="knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#34C759"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Тонкий слайдер -->
        <Style x:Key="Thin" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="14" Background="Transparent">
                            <Border Height="5" CornerRadius="2.5" Background="#3A3A3E" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate><Border Height="5" CornerRadius="2.5" Background="White"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template><ControlTemplate><Ellipse Fill="White"/></ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Scroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Width="4" Opacity="0.35"
                                       Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
                                <ScrollBar.Template>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.Thumb><Thumb><Thumb.Template><ControlTemplate><Border CornerRadius="2" Background="White"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                                        </Track>
                                    </ControlTemplate>
                                </ScrollBar.Template>
                            </ScrollBar>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- Сам остров -->
        <Grid x:Name="Shell" HorizontalAlignment="Center" VerticalAlignment="Top" Width="150" Height="32" Margin="0,6,0,0" ClipToBounds="True"
              RenderTransformOrigin="0.5,0" Cursor="Hand">
            <Grid.RenderTransform><TransformGroup><ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1"/><TranslateTransform x:Name="ShellSlide"/></TransformGroup></Grid.RenderTransform>
            <Rectangle x:Name="ShellBg" Fill="Black" RadiusX="16" RadiusY="16" Stroke="#1AFFFFFF" StrokeThickness="1"/>

            <!-- ======== КОМПАКТНЫЙ ВИД ======== -->
            <Grid x:Name="Compact" Margin="10,0,12,0" Height="32" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="CompactLeft" Grid.Column="0" VerticalAlignment="Center">
                    <ui:Mascot x:Name="MascotSmall" Width="26" Height="16"/>
                    <Border x:Name="CoverSmall" Width="22" Height="22" CornerRadius="6" Visibility="Collapsed">
                        <Border.Background><ImageBrush x:Name="CoverSmallBrush" Stretch="UniformToFill"/></Border.Background>
                    </Border>
                    <Ellipse x:Name="RecDot" Width="10" Height="10" Fill="#FF3B30" Visibility="Collapsed" Margin="4,0"/>
                    <TextBlock x:Name="CompactGlyph" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center" Visibility="Collapsed" Margin="2,0"/>
                </Grid>
                <TextBlock x:Name="CompactText" Grid.Column="1" Text="00:00" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                           HorizontalAlignment="Center" Margin="10,0,4,0" TextTrimming="CharacterEllipsis"/>
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel x:Name="Eq" Orientation="Horizontal" Height="14" Visibility="Collapsed" VerticalAlignment="Center">
                        <Rectangle x:Name="Eq1" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="#FF5AC8FA" Margin="1,0" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="Eq2" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="#FF5AC8FA" Margin="1,0" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.8"/></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="Eq3" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="#FF5AC8FA" Margin="1,0" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.55"/></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="Eq4" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="#FF5AC8FA" Margin="1,0" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform></Rectangle>
                    </StackPanel>
                    <TextBlock x:Name="CompactRight" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <Button x:Name="RecStopBtn" Style="{StaticResource Icon}" Width="24" Height="24" FontSize="10" Content="&#xE71A;" Foreground="#FF3B30"
                            Visibility="Collapsed" Click="RecStop_Click" ToolTip="Остановить запись"/>
                </Grid>
            </Grid>

            <!-- ======== РАЗВЁРНУТЫЙ ВИД ======== -->
            <Grid x:Name="Expanded" Margin="16,12,16,14" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" Cursor="Arrow">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- вкладки -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource Icon}" Content="&#xE713;" ToolTip="Настройки" Click="Settings_Click"/>
                        <Button x:Name="PinBtn" Style="{StaticResource Icon}" Content="&#xE718;" ToolTip="Не сворачивать" Click="Pin_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:Mascot x:Name="MascotBig" Width="30" Height="18" Margin="2,0,10,0" VerticalAlignment="Center"/>
                        <RadioButton x:Name="TabHome" Style="{StaticResource TabBtn}" Checked="Tab_Checked" Tag="home">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE80F;" FontSize="13" VerticalAlignment="Center"/><TextBlock Text=" Главная" FontSize="13"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabChat" Style="{StaticResource TabBtn}" Checked="Tab_Checked" Tag="chat">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8BD;" FontSize="13" VerticalAlignment="Center"/><TextBlock Text=" Нейросеть" FontSize="13"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabSound" Style="{StaticResource TabBtn}" Checked="Tab_Checked" Tag="sound">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE767;" FontSize="13" VerticalAlignment="Center"/><TextBlock Text=" Звук" FontSize="13"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabControl" Style="{StaticResource TabBtn}" Checked="Tab_Checked" Tag="control">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE705;" FontSize="13" VerticalAlignment="Center"/><TextBlock Text=" VPN" FontSize="13"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabShelf" Style="{StaticResource TabBtn}" Checked="Tab_Checked" Tag="shelf">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE77F;" FontSize="13" VerticalAlignment="Center"/><TextBlock Text=" Полка" FontSize="13"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabAgent" Style="{StaticResource TabBtn}" Checked="Tab_Checked" Tag="agent" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE99A;" FontSize="13" VerticalAlignment="Center"/><TextBlock x:Name="TabAgentText" Text=" Агент" FontSize="13"/></StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>

                <!-- ===== ГЛАВНАЯ ===== -->
                <Grid x:Name="PageHome" Grid.Row="1">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                    <!-- плеер -->
                    <Border Grid.Column="0" CornerRadius="18" Background="{StaticResource Card}" ClipToBounds="True" Margin="0,0,10,0">
                        <Grid>
                            <!-- мягкое отражение обложки: размытый фон -->
                            <!-- размытие считается один раз при смене трека (MakeGlow), а не на каждом кадре -->
                            <Image x:Name="CoverGlow" Stretch="UniformToFill" Opacity="0.38" Margin="-20" RenderOptions.BitmapScalingMode="Linear"/>
                            <!-- затемнение: на светлых обложках текст остаётся читаемым -->
                            <Rectangle Fill="#73000000" IsHitTestVisible="False"/>
                            <Grid Margin="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Grid.RowSpan="2">
                                    <Border x:Name="CoverBig" Width="72" Height="72" CornerRadius="12" Background="#2C2C30">
                                        <Grid>
                                            <TextBlock x:Name="CoverPlaceholder" FontFamily="{StaticResource Icons}" Text="&#xE8D6;" FontSize="26" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border CornerRadius="12"><Border.Background><ImageBrush x:Name="CoverBigBrush" Stretch="UniformToFill"/></Border.Background></Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="12,2,0,0">
                                    <TextBlock x:Name="MediaTitle" Text="Ничего не играет" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="MediaArtist" Text="Включи музыку — остров оживёт" FontSize="12.5" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    <Border x:Name="MediaAppBadge" HorizontalAlignment="Left" Background="#22FFFFFF" CornerRadius="6" Padding="6,1" Margin="0,6,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="MediaApp" FontSize="10.5" Foreground="#CCFFFFFF"/>
                                    </Border>
                                </StackPanel>
                                <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="MediaPos" Text="0:00" FontSize="10.5" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Width="34"/>
                                    <Slider x:Name="MediaSeek" Grid.Column="1" Style="{StaticResource Thin}" Minimum="0" Maximum="1" Margin="4,0"
                                            PreviewMouseLeftButtonUp="MediaSeek_Up" PreviewMouseLeftButtonDown="MediaSeek_Down"/>
                                    <TextBlock x:Name="MediaDur" Grid.Column="2" Text="0:00" FontSize="10.5" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Width="34" TextAlignment="Right"/>
                                </Grid>
                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource Icon}" Content="&#xE892;" Click="Prev_Click"/>
                                    <Button x:Name="PlayBtn" Style="{StaticResource Icon}" Width="38" Height="38" FontSize="20" Content="&#xE768;" Margin="10,0" Click="Play_Click"/>
                                    <Button Style="{StaticResource Icon}" Content="&#xE893;" Click="Next_Click"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- быстрые действия -->
                    <UniformGrid Grid.Column="1" Rows="2" Columns="4">
                        <Button Style="{StaticResource Tile}" Margin="0,0,6,6" Click="Act_Region"><StackPanel><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE7A8;" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="Область" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                        <Button Style="{StaticResource Tile}" Margin="0,0,6,6" Click="Act_Full"><StackPanel><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE740;" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="Весь экран" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                        <Button Style="{StaticResource Tile}" Margin="0,0,6,6" Click="Act_Ocr"><StackPanel><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8D2;" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="Текст с экрана" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                        <Button Style="{StaticResource Tile}" Margin="0,0,0,6" Click="Act_Qr"><StackPanel><TextBlock FontFamily="{StaticResource Icons}" Text="&#xED14;" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="QR-код" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                        <Button Style="{StaticResource Tile}" Margin="0,0,6,0" Click="Act_Mixer"><StackPanel><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE9E9;" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="Микшер" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="RecTile" Style="{StaticResource Tile}" Margin="0,0,6,0" Click="Act_Record"><StackPanel><TextBlock x:Name="RecTileIcon" FontFamily="{StaticResource Icons}" Text="&#xE7C8;" FontSize="18" HorizontalAlignment="Center"/><TextBlock x:Name="RecTileText" Text="Запись экрана" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                        <Button Style="{StaticResource Tile}" Margin="0,0,6,0" Click="Act_Plain"><StackPanel><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8E9;" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="Чистый текст" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                        <Button Style="{StaticResource Tile}" Click="Act_Folder"><StackPanel><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8B7;" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="Снимки" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
                    </UniformGrid>

                    <!-- закреплённые приложения + громкость -->
                    <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="2,12,2,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="200">
                            <Button x:Name="MuteBtn" Style="{StaticResource Icon}" Width="28" Height="28" Content="&#xE767;" Click="Mute_Click"/>
                            <Slider x:Name="VolSlider" Style="{StaticResource Thin}" Width="160" Minimum="0" Maximum="1" VerticalAlignment="Center" ValueChanged="Vol_Changed"/>
                        </StackPanel>
                        <ItemsControl x:Name="PinnedApps" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </DockPanel>
                </Grid>

                <!-- ===== НЕЙРОСЕТЬ ===== -->
                <Grid x:Name="PageChat" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ScrollViewer x:Name="ChatScroll" Style="{StaticResource Scroll}">
                        <StackPanel x:Name="ChatList" Margin="0,0,8,0">
                            <TextBlock x:Name="ChatHint" Text="С возвращением, начинайте в любое время." Foreground="{StaticResource Dim}" FontSize="13" Margin="4,8"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" Background="{StaticResource Card}" CornerRadius="16" Margin="0,10,0,0" Padding="12,4,4,4">
                        <DockPanel>
                            <Button x:Name="ChatSend" DockPanel.Dock="Right" Style="{StaticResource Icon}" Content="&#xE724;" Background="#0A84FF" Width="32" Height="32" Click="ChatSend_Click" VerticalAlignment="Bottom"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Icon}" Content="&#xE710;" ToolTip="Новый чат" Width="32" Height="32" Click="ChatNew_Click" Foreground="{StaticResource Dim}" VerticalAlignment="Bottom"/>
                            <Grid>
                                <TextBlock x:Name="ChatPlaceholder" Text="Спросите что-нибудь…" Foreground="#66FFFFFF" FontSize="13.5" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0"/>
                                <TextBox x:Name="ChatInput" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White" FontSize="13.5"
                                         TextWrapping="Wrap" AcceptsReturn="False" MaxHeight="90" VerticalAlignment="Center" Padding="0,6"
                                         VerticalScrollBarVisibility="Auto" PreviewKeyDown="ChatInput_KeyDown" TextChanged="ChatInput_TextChanged"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ===== VPN + ПИТАНИЕ ===== -->
                <Grid x:Name="PageControl" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <!-- Happ -->
                    <Border x:Name="HappCard" Background="{StaticResource Card}" CornerRadius="18" Padding="14,12" Margin="0,0,0,8">
                        <DockPanel>
                            <ToggleButton x:Name="HappToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="HappToggle_Click" ToolTip="Подключить / отключить"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Icon}" Width="30" Height="30" FontSize="13" Content="&#xE8A7;" Margin="0,0,10,0" ToolTip="Открыть Happ — там выбор сервера" Click="HappOpen_Click"/>
                            <Border Width="42" Height="42" CornerRadius="12" Background="#2C2C30">
                                <Image x:Name="HappIcon" Width="28" Height="28"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Happ" FontSize="15" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Ellipse x:Name="HappDot" Width="7" Height="7" Fill="#8E8E93" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HappStatus" Text="Проверяю…" FontSize="12" Foreground="{StaticResource Dim}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- остальные VPN Windows -->
                    <Border Grid.Row="1" Background="{StaticResource Card}" CornerRadius="16" Padding="10">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="4,0,2,4">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Icon}" Width="22" Height="22" FontSize="11" Content="&#xE713;" ToolTip="Параметры VPN Windows" Click="VpnSettings_Click"/>
                                <TextBlock Text="VPN Windows" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" Foreground="#CCFFFFFF"/>
                            </DockPanel>
                            <ScrollViewer Style="{StaticResource Scroll}"><StackPanel x:Name="VpnList"/></ScrollViewer>
                        </DockPanel>
                    </Border>

                    <UniformGrid Grid.Row="2" Rows="1" Margin="0,8,0,0" Height="46">
                        <Button Style="{StaticResource Tile}" Margin="0,0,6,0" Click="Power_Lock"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE72E;" VerticalAlignment="Center"/><TextBlock Text="  Блокировка" FontSize="12"/></StackPanel></Button>
                        <Button Style="{StaticResource Tile}" Margin="0,0,6,0" Click="Power_Sleep"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE708;" VerticalAlignment="Center"/><TextBlock Text="  Сон" FontSize="12"/></StackPanel></Button>
                        <Button x:Name="RestartBtn" Style="{StaticResource Tile}" Margin="0,0,6,0" Click="Power_Restart"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE72C;" VerticalAlignment="Center"/><TextBlock x:Name="RestartText" Text="  Перезагрузка" FontSize="12"/></StackPanel></Button>
                        <Button x:Name="ShutdownBtn" Style="{StaticResource Tile}" Click="Power_Shutdown"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE7E8;" VerticalAlignment="Center"/><TextBlock x:Name="ShutdownText" Text="  Выключение" FontSize="12"/></StackPanel></Button>
                    </UniformGrid>
                </Grid>

                <!-- ===== ЗВУК (микшер) ===== -->
                <ui:MixerView x:Name="PageSound" Grid.Row="1" Visibility="Collapsed"/>

                <!-- ===== ПОЛКА ===== -->
                <Grid x:Name="PageShelf" Grid.Row="1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Card}" CornerRadius="16" Padding="10" Margin="0,0,6,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="4,0,2,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Icon}" Width="22" Height="22" FontSize="11" Content="&#xE74D;" ToolTip="Очистить историю" Click="ClipClear_Click"/>
                                <TextBlock Text="История буфера" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ScrollViewer Style="{StaticResource Scroll}"><StackPanel x:Name="ClipList"/></ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border x:Name="ShelfDrop" Grid.Column="1" Background="{StaticResource Card}" CornerRadius="16" Padding="10" BorderBrush="Transparent" BorderThickness="1.5">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="4,0,2,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Icon}" Width="22" Height="22" FontSize="11" Content="&#xE74D;" ToolTip="Очистить полку" Click="ShelfClear_Click"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Icon}" Width="22" Height="22" FontSize="11" Content="&#xE8C8;" ToolTip="Скопировать все файлы" Click="ShelfCopy_Click"/>
                                <TextBlock Text="Полка для файлов" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid>
                                <TextBlock x:Name="ShelfHint" Text="Перетащи файлы на остров —&#x0a;они подождут здесь" Foreground="{StaticResource Dim}" FontSize="12" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <ScrollViewer Style="{StaticResource Scroll}"><WrapPanel x:Name="ShelfList"/></ScrollViewer>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ===== АГЕНТ (Claude Code / opencode) ===== -->
                <Border x:Name="PageAgent" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource Card}" CornerRadius="16" Padding="16,12">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="AgentProject" DockPanel.Dock="Right" Foreground="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AgentSource" Text="Claude Code" FontWeight="SemiBold" FontSize="14"/>
                        </DockPanel>
                        <TextBlock x:Name="AgentDetail" Foreground="#DDFFFFFF" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <Border x:Name="AgentReqBox" Visibility="Collapsed" Margin="0,10,0,0" Background="#141416" CornerRadius="12" Padding="12,10">
                            <StackPanel>
                                <TextBlock x:Name="AgentReqTitle" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap"/>
                                <TextBlock x:Name="AgentReqDetail" Foreground="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" FontFamily="Cascadia Mono, Consolas"/>
                                <WrapPanel x:Name="AgentReqButtons" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
